# ============================================================
# 前端环境变量配置示例
# 复制此文件为 .env 并修改
# ============================================================

# 后端 API 地址（开发模式留空 = Vite 代理到 localhost:8000）
VITE_API_BASE=/api

# WebSocket 地址（留空 = 使用当前页面地址）
VITE_WS_URL=ws://localhost:8000/ws

# 默认自动刷新间隔（秒），0=关闭，0.5=500ms，1=1秒
VITE_REFRESH_INTERVAL=0
