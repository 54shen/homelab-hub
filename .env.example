# ============================================================
# Shared Center — 环境变量配置示例
# 复制此文件为 .env 并修改
# ============================================================

# ---- 数据库 ----
# SQLite 数据库文件路径
DATABASE_URL=sqlite:///./data/shared_center.db

# ---- 数据清理 ----
# 历史数据默认保留天数（每个 key 可在前端单独覆盖）
DEFAULT_RETENTION_DAYS=180
# 定时清理间隔（小时）
CLEANUP_INTERVAL_HOURS=24

# ---- 设备管理 ----
# 设备心跳超时（秒），超过此时间未收到心跳自动标记离线
HEARTBEAT_TIMEOUT_SECONDS=60
